agent Main extends Base {
    plan +!main(list args) {
        cartago.startService();
    	cartago.link();
        
        !setup();

        !floorplan(cartago.ArtifactId _);

        S.createAgent("r1", "Robot");

        // You can discover a list of the current locations by examining the floorplan...
        ?locations(list L);
        cartago.println("L=" + L);

        // Example: Robot r1 is assigned to ap1 and ws1. ws1 can be used to make apple pies.
        //          r1 retrieves the necessary ingredients and then creates the apple pie
        //          it should drop the apple pie to the packaging point for delivery...
        
        // Retrieve an item from the warehouse and place at ap1
        !available("ap1", "apples");
                
        // ROBOT: Move item from ap1 to ws1
        !transfer("r1", "ap1", "ws1");

        // Example of retrieving an item based on the
        // inputsNeeded property of the workstation.
        ?inputsNeeded("ws1", list items);
        !available("ap1", P.headAsString(items));

        // ROBOT: Move item from ap1 to ws1
        !transfer("r1", "ap1", "ws1");

        // Check what the state of ws1 is (not a robot operation)
        ?state("ws1", string state);
        cartago.println("ws1 is: " + state);

        // Now, operate the workstation (not the robot)
        !operate("ws1");

        // ROBOT: Pickup the output when finished...
        !transfer("r1", "ws1", "sp1");

        ?available("sp1", string spItem);

        !transfer("r1", "sp1", "pp1");
    }

    plan +!transfer(string name, string from, string to) {
        send(request, name, transfer(from, to));
        wait(transferred(from, to));
        -transferred(from, to);
    }

    plan @message(inform, string sender, transferred(string from, string to)) {
        cartago.println(sender + " is at location: " + to);
        +transferred(from, to);
    }

    plan +!setup() {
        !warehouse(cartago.ArtifactId wId);
        !addToWarehouse("apples", 2);
        !addToWarehouse("pastry", 10);

        !floorplan(cartago.ArtifactId fpId);

        !accessPoint("ap1", cartago.ArtifactId ap1Id);
        !accessPoint("ap2", cartago.ArtifactId ap2Id);

        !storagePoint("sp1", cartago.ArtifactId sp1Id);

        !packagingPoint("pp1", cartago.ArtifactId pp1Id);
        !order("pp1", ["apple-pie"]);

        !robot("r1", cartago.ArtifactId r1Id);
        !robot("r2", cartago.ArtifactId r2Id);
        
        !workstation("ws1", cartago.ArtifactId ws1Id);
        !configure("ws1", ["apples", "pastry"], "apple-pie", 2000l);
    }

}